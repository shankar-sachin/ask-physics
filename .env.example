# Copy to .env and fill in. Never commit .env.

# Only needed for the real Anthropic client (pip install -e ".[anthropic]").
# Tests and the default CLI path use FakeLLMClient and need no key.
ANTHROPIC_API_KEY=your-api-key-here

# Optional overrides for askphysics.config.Settings
# ASKPHYSICS_LLM_PROVIDER=fake
# ASKPHYSICS_MODEL=claude-opus-5-5
# ASKPHYSICS_TOP_K=5
# ASKPHYSICS_TEMPERATURE=0.0
