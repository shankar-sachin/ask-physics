# Ask Physics reads its settings from environment variables. It does not read a .env
# file, so copying this file does nothing. Export each variable you want in your shell,
# or in a shell profile such as ~/.bashrc or ~/.zshrc, before you run askphysics:
#
#   export ASKPHYSICS_MODEL=fermi-solem-1
#
# Ask Physics runs entirely locally: no API keys, no external LLM services.

# auto uses the Fermi models when any are installed, else the fake client.
# ASKPHYSICS_LLM_PROVIDER=auto
# Force one model for every stage; unset routes tellus -> solem -> celeste.
# ASKPHYSICS_MODEL=fermi-solem-1
# ASKPHYSICS_MODEL_DIR=~/.cache/askphysics/models
# ASKPHYSICS_DEVICE=mps
# ASKPHYSICS_PLAN_ATTEMPTS=5
# ASKPHYSICS_ESCALATIONS=1
# ASKPHYSICS_TOP_K=5
# ASKPHYSICS_TEMPERATURE=0.0
