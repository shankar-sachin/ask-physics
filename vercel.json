{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "mkdir -p build/site/installers && cp install.sh install.ps1 build/site/installers/",
  "outputDirectory": "build/site",
  "headers": [
    {
      "source": "/installers/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://github.com/shankar-sachin/ask-physics",
      "permanent": false
    }
  ]
}
